{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "utm-move.vercel.app"
        }
      ],
      "destination": "https://utm.abrahamtan.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!sw\\.js$).+)",
      "has": [
        {
          "type": "host",
          "value": "utm-move.vercel.app"
        }
      ],
      "destination": "https://utm.abrahamtan.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sw.js",
      "has": [
        {
          "type": "host",
          "value": "utm-move.vercel.app"
        }
      ],
      "destination": "/kill-sw.js"
    },
    {
      "source": "/sw.js",
      "destination": "/app-sw.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sw|app-sw|kill-sw).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
